{
  // Deployment config for Cloudflare Workers static assets: `wrangler deploy`
  // uploads the build output and serves it, with no Worker script of its own —
  // there is no `main` here because the site is files and nothing else.
  "name": "immersivemapwebpage",
  "compatibility_date": "2026-09-23",

  // Rendering the site is part of deploying it: wrangler runs this before it
  // uploads anything, so a deploy from a fresh clone works with no build step
  // configured anywhere else. `go run` rather than `make site` because the
  // build image is guaranteed to have Go and not guaranteed to have make.
  "build": {
    "command": "go run . -content articles -tutorials tutorials -site site -out dist -base-url https://immersivemap.dev"
  },
  "assets": {
    // Produced by `make site`, wiped and rewritten on every build. The _headers
    // file the generator copies to the root of it is read from here too: it is
    // parsed as configuration rather than served as a file.
    "directory": "./dist",

    // Directory-style URLs: /articles/ is served from articles/index.html, and
    // a request for /articles is redirected to it rather than 404ing.
    "html_handling": "auto-trailing-slash",

    // Anything that matches no file gets 404.html, with a 404 status, rather
    // than an empty response from the edge.
    "not_found_handling": "404-page"
  }
}
