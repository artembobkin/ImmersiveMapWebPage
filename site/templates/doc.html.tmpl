{{define "head" -}}
<title>{{.Doc.Title}} · ImmersiveMap documentation</title>
<meta name="description" content="{{.Doc.Description}}" />
<link rel="canonical" href="{{.Doc.AbsURL}}" />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="ImmersiveMap" />
<meta property="og:title" content="{{.Doc.Title}}" />
<meta property="og:description" content="{{.Doc.Description}}" />
<meta property="og:url" content="{{.Doc.AbsURL}}" />
<meta property="og:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{.Doc.Title}}" />
<meta name="twitter:description" content="{{.Doc.Description}}" />
<meta name="twitter:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />
{{- end}}

{{define "content" -}}
<!-- These pages are the Documentation folder of the engine's repository
     (documentation/, kept in step with GitHub by the follow-readme workflow),
     rendered at build time by docs.go. Change the text on GitHub, and they
     follow. -->
<div class="wrap docs-layout">
  <nav class="docs-nav" aria-label="Documentation pages">
    <p class="docs-side-title">Documentation</p>
    <ul>
    {{- range .Docs}}
      <li><a href="{{.URL}}"{{if eq .Slug $.Doc.Slug}} aria-current="page"{{end}}>{{.Title}}</a></li>
    {{- end}}
    </ul>
  </nav>

  <article class="docs-article">
    <h1>{{.Doc.Title}}</h1>
    <div class="post-body">
{{.Doc.HTML}}
    </div>

    {{- if or .PrevDoc .NextDoc}}
    <nav class="docs-pager" aria-label="Previous and next page">
      {{- with .PrevDoc}}
      <a class="prev" rel="prev" href="{{.URL}}"><span>Previous</span>{{.Title}}</a>
      {{- end}}
      {{- with .NextDoc}}
      <a class="next" rel="next" href="{{.URL}}"><span>Next</span>{{.Title}}</a>
      {{- end}}
    </nav>
    {{- end}}
  </article>

  {{- if .Doc.Sections}}
  <nav class="docs-toc" aria-label="On this page">
    <p class="docs-side-title">On this page</p>
    <ul>
    {{- range .Doc.Sections}}
      <li><a href="#{{.ID}}">{{.Title}}</a></li>
    {{- end}}
    </ul>
  </nav>
  {{- end}}
</div>
{{- end}}

{{define "scripts" -}}
<script>
/* Heading anchors, same as on the article pages. */
(function () {
  var hs = document.querySelectorAll(".post-body h2[id], .post-body h3[id]");
  for (var i = 0; i < hs.length; i++) {
    var a = document.createElement("a");
    a.className = "anchor";
    a.href = "#" + hs[i].id;
    a.textContent = "#";
    a.setAttribute("aria-hidden", "true");
    hs[i].appendChild(a);
  }
})();
</script>
{{- end}}
