{{define "head" -}}
<title>Documentation · ImmersiveMap</title>
<meta name="description" content="How to use ImmersiveMap in a SwiftUI app: the camera, the style, the tile source, the relief and the attribution." />
<link rel="canonical" href="{{.Site.BaseURL}}/documentation/" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="ImmersiveMap" />
<meta property="og:title" content="Documentation · ImmersiveMap" />
<meta property="og:description" content="How to use ImmersiveMap in a SwiftUI app." />
<meta property="og:url" content="{{.Site.BaseURL}}/documentation/" />
<meta property="og:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Documentation · ImmersiveMap" />
<meta name="twitter:description" content="How to use ImmersiveMap in a SwiftUI app." />
<meta name="twitter:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />
{{- end}}

{{define "content" -}}
<!-- These pages are the Documentation folder of the engine's repository
     (documentation/, kept in step with GitHub by the follow-readme workflow),
     rendered at build time by docs.go. Change the text on GitHub, and they
     follow. -->
<section class="page-head">
  <div class="wrap-narrow">
    <h1>Documentation</h1>
    <p class="page-note">How to use the engine</p>
  </div>
</section>

<div class="wrap-narrow">
  <ul class="post-list">
  {{- range .Docs}}
    <li class="post-card">
      <h2><a href="{{.URL}}">{{.Title}}</a></h2>
      <p>{{.Description}}</p>
    </li>
  {{- end}}
  </ul>
</div>
{{- end}}
