{{define "base" -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f3f6fc" />
{{template "head" .}}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='none' stroke='%234d9bff' stroke-width='2'/%3E%3Cellipse cx='16' cy='16' rx='5.5' ry='13' fill='none' stroke='%234d9bff' stroke-width='2'/%3E%3Cline x1='3' y1='16' x2='29' y2='16' stroke='%234d9bff' stroke-width='2'/%3E%3C/svg%3E" />
<link rel="alternate" type="application/rss+xml" title="ImmersiveMap articles" href="{{.Site.BaseURL}}/articles/feed.xml" />
<style>
{{range .Styles}}{{.}}
{{end}}</style>
</head>

<body>
{{block "body-top" .}}{{end}}
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="ImmersiveMap home"{{if eq .Section "home"}} aria-current="page"{{end}}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2"/><ellipse cx="16" cy="16" rx="5.5" ry="13" fill="none" stroke="currentColor" stroke-width="2"/><line x1="3" y1="16" x2="29" y2="16" stroke="currentColor" stroke-width="2"/></svg>
      <span class="wm"><b>Immersive</b>Map</span>
    </a>
    <nav class="nav-links">
      <!-- The landing page is the README, so nothing here points into it: its
           headings are GitHub's to rename. Articles are in the header because
           the README does not link to them, and without a link here they would
           be reachable by URL alone. Tutorials are not linked: the section
           still builds and is reachable at /tutorials/, it is just not in the
           chrome. -->
      <a href="/articles/"{{if eq .Section "articles"}} aria-current="page"{{end}}>Articles</a>
      <a href="https://github.com/artembobkin/ImmersiveMap">GitHub</a>
      <button class="icon-btn" id="themeToggle" aria-label="Toggle color theme" title="Toggle theme">
        <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg>
      </button>
    </nav>
  </div>
</header>

<main>
{{template "content" .}}
</main>

<footer class="site">
  <div class="wrap foot-inner">
    <span>© 2025–{{.Site.Year}} Artem Bobkin · MIT License</span>
    <div class="foot-links">
      <!-- Articles, Tutorials and RSS are not linked here either: the pages and
           the feed still exist and are reachable by URL, they are just not in
           the chrome for now. -->
      <a href="/">Home</a>
      <a href="https://github.com/artembobkin/ImmersiveMap">GitHub</a>
      <!-- Getting in touch happens on GitHub: the issue tracker is where a bug
           in the engine belongs, and there is no form on the site to take it. -->
      <a href="https://github.com/artembobkin/ImmersiveMap/issues">Report a bug</a>
      <a href="https://swiftpackageindex.com/artembobkin/ImmersiveMap">Swift Package Index</a>
      <a href="https://www.reddit.com/user/devslacker/submitted/">Reddit</a>
      <a href="https://github.com/artembobkin/ImmersiveMap#readme">Docs</a>
    </div>
  </div>
</footer>

<script>
(function () {
  var root = document.documentElement;

  /* Theme, with persistence. Default to light unless the visitor has explicitly
     chosen one, and set the attribute before anything paints. */
  var saved = null;
  try { saved = localStorage.getItem("im-theme"); } catch (e) {}
  root.setAttribute("data-theme", (saved === "dark" || saved === "light") ? saved : "light");

  var btn = document.getElementById("themeToggle");
  if (btn) {
    btn.addEventListener("click", function () {
      var cur = root.getAttribute("data-theme");
      if (!cur) cur = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      var next = cur === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("im-theme", next); } catch (e) {}
    });
  }

})();
</script>
{{block "scripts" .}}{{end}}
</body>
</html>
{{- end}}
