{{define "head" -}}
<title>ImmersiveMap · Swift + Metal map engine for SwiftUI with a 3D globe</title>
<meta name="description" content="{{.Description}}" />
<link rel="canonical" href="{{.Site.BaseURL}}/" />
<meta name="keywords" content="SwiftUI map, Metal map engine, MapKit alternative, Mapbox alternative iOS, vector tiles Swift, 3D globe SwiftUI, iOS map SDK, macOS map" />

<!-- Open Graph / social cards -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="ImmersiveMap" />
<meta property="og:title" content="ImmersiveMap · a native Swift + Metal map engine for SwiftUI" />
<meta property="og:description" content="{{.Description}}" />
<meta property="og:url" content="{{.Site.BaseURL}}/" />
<meta property="og:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="ImmersiveMap · a native Swift + Metal map engine for SwiftUI" />
<meta name="twitter:description" content="{{.Description}}" />
<meta name="twitter:image" content="{{.Site.BaseURL}}/assets/og-cover.png" />

<script type="application/ld+json">{{.JSONLD}}</script>
{{- end}}

{{define "content" -}}
<!-- The landing page is the engine's README (landing/README.md, kept in step
     with GitHub by the follow-readme workflow), rendered at build time by
     readme.go. Nothing of it is written here: change the README on GitHub,
     and the page follows. -->
<article class="post readme">
  <div class="wrap-narrow">
    <div class="post-body">
{{.Readme}}
    </div>
  </div>
</article>
{{- end}}
