{{define "scripts" -}}
<script>
(function () {
  var root = document.documentElement;

  /* copy the package URL from the quick start */
  var copyBtn = document.getElementById("copyPkg");
  if (copyBtn && navigator.clipboard) {
    copyBtn.addEventListener("click", function () {
      navigator.clipboard.writeText(document.getElementById("pkgUrl").textContent).then(function () {
        copyBtn.textContent = "Copied";
        setTimeout(function () { copyBtn.textContent = "Copy"; }, 1300);
      });
    });
  }

  /* starfield: only on dark ground, respects reduced motion */
  var canvas = document.getElementById("stars");
  var ctx = canvas.getContext("2d");
  var stars = [], raf = null, w = 0, h = 0;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function effectiveDark() {
    var t = root.getAttribute("data-theme");
    if (t) return t === "dark";
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }
  function starColor() {
    return getComputedStyle(root).getPropertyValue("--star").trim() || "rgba(210,226,250,0.9)";
  }
  function resize() {
    w = canvas.width = Math.floor(innerWidth * Math.min(devicePixelRatio, 2));
    h = canvas.height = Math.floor(innerHeight * Math.min(devicePixelRatio, 2));
    canvas.style.width = innerWidth + "px";
    canvas.style.height = innerHeight + "px";
    var count = Math.min(150, Math.floor(innerWidth * innerHeight / 9000));
    stars = [];
    for (var i = 0; i < count; i++) {
      stars.push({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.3 + 0.2, a: Math.random(), s: Math.random() * 0.02 + 0.004 });
    }
  }
  function drawStars() {
    if (raf) { cancelAnimationFrame(raf); raf = null; }
    ctx.clearRect(0, 0, w, h);
    if (!effectiveDark()) return;
    var col = starColor();
    if (reduce) {
      for (var i = 0; i < stars.length; i++) {
        var st = stars[i];
        ctx.globalAlpha = 0.35 + st.a * 0.5;
        ctx.fillStyle = col; ctx.beginPath(); ctx.arc(st.x, st.y, st.r, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1; return;
    }
    (function tick() {
      ctx.clearRect(0, 0, w, h);
      for (var i = 0; i < stars.length; i++) {
        var st = stars[i];
        st.a += st.s; var tw = 0.35 + (Math.sin(st.a) * 0.5 + 0.5) * 0.6;
        ctx.globalAlpha = tw; ctx.fillStyle = col;
        ctx.beginPath(); ctx.arc(st.x, st.y, st.r, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(tick);
    })();
  }

  var rt;
  addEventListener("resize", function () { clearTimeout(rt); rt = setTimeout(function () { resize(); drawStars(); }, 150); });
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", drawStars);
  /* The starfield watches the theme rather than being called when it changes.
     The toggle lives in the shared shell, which must not know that one page out
     of seven draws stars; and watching catches every way the attribute can
     move, not just that one click handler. */
  new MutationObserver(drawStars).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  resize(); drawStars();
})();
</script>
{{- end}}
